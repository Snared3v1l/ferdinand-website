# FUTUREVERSE

A responsive, futuristic 3D website built with HTML, CSS, vanilla JavaScript, and Three.js.

## Run locally

Three.js is loaded as an ES module, so serve the folder over HTTP rather than opening `index.html` directly.

### Option A: Python
1. Install Python if needed.
2. Open a terminal in this folder.
3. Run: `python -m http.server 8000`
4. Open `http://localhost:8000` in your browser.

### Option B: VS Code
Install the Live Server extension, right-click `index.html`, and choose **Open with Live Server**.

## Features
- Interactive Three.js energy sphere, orbital rings, and particles
- Responsive mobile navigation
- Particle density, motion, and color controls
- Scroll reveal effects and reduced-motion support
- Accessible local demo form validation

## Notes
- An internet connection is needed to load Three.js from jsDelivr and the optional Google Fonts.
- The contact form is intentionally demo-only. It validates in the browser but does not send or store messages.
- If WebGL is unavailable, the page displays a helpful fallback and the rest of the site remains usable.

import * as THREE from 'three';

const canvas = document.querySelector('#universe');
const root = document.documentElement;
const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
const prefersLowPower = window.matchMedia('(max-width: 680px)').matches || (navigator.hardwareConcurrency && navigator.hardwareConcurrency <= 4);
const state = { running: !reducedMotion.matches, motion: reducedMotion.matches ? 0 : 0.6, density: 'medium', theme: 'blue' };
const palettes = {
  blue: { core: 0x5be7ff, secondary: 0x8a67ff, css: '#5be7ff', rgb: '91,231,255' },
  violet: { core: 0xb39aff, secondary: 0xf079ff, css: '#b39aff', rgb: '179,154,255' },
  cyan: { core: 0x67ffd0, secondary: 0x55e8ff, css: '#67ffd0', rgb: '103,255,208' }
};
let scene, camera, renderer, group, core, coreMaterial, particles, particleGeometry, particleMaterial, ringGroup;
let particleCount = 900, animationFrame = 0, lastTime = 0, elapsed = 0, pointerX = 0, pointerY = 0;
const clock = new THREE.Clock();

function setTheme(theme) {
  state.theme = theme;
  const palette = palettes[theme] || palettes.blue;
  root.style.setProperty('--accent', palette.css);
  root.style.setProperty('--accent-rgb', palette.rgb);
  if (coreMaterial) coreMaterial.color.setHex(palette.core);
  if (particleMaterial) particleMaterial.color.setHex(palette.core);
  if (ringGroup) ringGroup.children.forEach((ring, i) => ring.material.color.setHex(i % 2 ? palette.secondary : palette.core));
  document.querySelectorAll('.theme-swatch').forEach(button => {
    const selected = button.dataset.theme === theme;
    button.classList.toggle('selected', selected);
    button.setAttribute('aria-pressed', String(selected));
  });
}

function createScene() {
  try {
    scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x070914, 0.065);
    camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100);
    camera.position.set(0, 0, 7.4);
    renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: !prefersLowPower, powerPreference: 'low-power' });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, prefersLowPower ? 1.25 : 1.7));
    renderer.setClearColor(0x070914, 0);
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    group = new THREE.Group();
    scene.add(group);
    ringGroup = new THREE.Group();
    group.add(ringGroup);

    const sphereGeo = new THREE.IcosahedronGeometry(1.13, 4);
    coreMaterial = new THREE.MeshStandardMaterial({
      color: palettes[state.theme].core, metalness: 0.68, roughness: 0.27,
      emissive: palettes[state.theme].core, emissiveIntensity: 0.22, wireframe: true,
      transparent: true, opacity: 0.78
    });
    core = new THREE.Mesh(sphereGeo, coreMaterial);
    group.add(core);

    const inner = new THREE.Mesh(
      new THREE.IcosahedronGeometry(0.82, 2),
      new THREE.MeshBasicMaterial({ color: 0x15264c, wireframe: true, transparent: true, opacity: 0.34 })
    );
    group.add(inner);

    const shell = new THREE.Mesh(
      new THREE.SphereGeometry(1.05, 28, 20),
      new THREE.MeshBasicMaterial({ color: palettes[state.theme].core, transparent: true, opacity: 0.045, side: THREE.BackSide })
    );
    group.add(shell);

    for (let i = 0; i < 3; i++) {
      const geometry = new THREE.TorusGeometry(1.55 + i * 0.15, 0.006 + i * 0.001, 5, 180);
      const material = new THREE.MeshBasicMaterial({ color: i % 2 ? palettes[state.theme].secondary : palettes[state.theme].core, transparent: true, opacity: 0.48 - i * 0.08 });
      const ring = new THREE.Mesh(geometry, material);
      ring.rotation.set(0.55 + i * 0.7, 0.2 + i * 0.5, i * 0.42);
      ringGroup.add(ring);
    }

    const ambient = new THREE.AmbientLight(0x8296ff, 1.3);
    scene.add(ambient);
    const point = new THREE.PointLight(palettes[state.theme].core, 20, 10);
    point.position.set(2, 2, 3);
    scene.add(point);
    const violetLight = new THREE.PointLight(palettes[state.theme].secondary, 12, 9);
    violetLight.position.set(-2, -1, -2);
    scene.add(violetLight);

    createParticles(particleCount);
    addStars();
    resizeScene();
    setTheme(state.theme);
    if (reducedMotion.matches) state.motion = 0;
    document.querySelector('#motion').value = String(Math.round(state.motion * 100));
    document.querySelector('#motion-value').textContent = `${Math.round(state.motion * 100)}%`;
    document.querySelector('#animation-toggle').setAttribute('aria-checked', String(state.running));
    document.querySelector('#loading-fallback')?.remove();
    renderer.domElement.dataset.ready = 'true';
    animate();
  } catch (error) {
    console.error('Futureverse 3D scene could not initialize:', error);
    show3DFallback();
  }
}

function createParticles(count) {
  if (particles) {
    group.remove(particles);
    particleGeometry.dispose();
    particleMaterial.dispose();
  }
  particleCount = count;
  const positions = new Float32Array(count * 3);
  const sizes = new Float32Array(count);
  for (let i = 0; i < count; i++) {
    const radius = 1.45 + Math.random() * 2.7;
    const theta = Math.random() * Math.PI * 2;
    const phi = Math.acos(2 * Math.random() - 1);
    positions[i * 3] = radius * Math.sin(phi) * Math.cos(theta);
    positions[i * 3 + 1] = radius * Math.sin(phi) * Math.sin(theta);
    positions[i * 3 + 2] = radius * Math.cos(phi);
    sizes[i] = Math.random();
  }
  particleGeometry = new THREE.BufferGeometry();
  particleGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  particleGeometry.setAttribute('aSize', new THREE.BufferAttribute(sizes, 1));
  particleMaterial = new THREE.PointsMaterial({ color: palettes[state.theme].core, size: prefersLowPower ? 0.018 : 0.022, transparent: true, opacity: 0.76, sizeAttenuation: true, depthWrite: false });
  particles = new THREE.Points(particleGeometry, particleMaterial);
  group.add(particles);
}

function addStars() {
  const count = prefersLowPower ? 180 : 360;
  const positions = new Float32Array(count * 3);
  for (let i = 0; i < count; i++) {
    positions[i * 3] = (Math.random() - 0.5) * 15;
    positions[i * 3 + 1] = (Math.random() - 0.5) * 10;
    positions[i * 3 + 2] = -2 - Math.random() * 8;
  }
  const geometry = new THREE.BufferGeometry();
  geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  const stars = new THREE.Points(geometry, new THREE.PointsMaterial({ color: 0x9aaeff, size: 0.012, transparent: true, opacity: 0.6 }));
  scene.add(stars);
}

function resizeScene() {
  if (!renderer || !camera) return;
  const rect = canvas.getBoundingClientRect();
  const width = Math.max(1, rect.width);
  const height = Math.max(1, rect.height);
  renderer.setSize(width, height, false);
  camera.aspect = width / height;
  camera.position.z = width < 420 ? 8.4 : width < 680 ? 7.8 : 7.4;
  camera.updateProjectionMatrix();
}

function animate(now = 0) {
  animationFrame = requestAnimationFrame(animate);
  if (!renderer || !state.running || document.hidden) return;
  if (now - lastTime < (prefersLowPower ? 32 : 16)) return;
  lastTime = now;
  const delta = Math.min(clock.getDelta(), 0.05);
  elapsed += delta * state.motion;
  const speed = state.motion;
  if (core) {
    core.rotation.y += delta * 0.12 * speed;
    core.rotation.x += delta * 0.055 * speed;
  }
  if (group) {
    group.rotation.y += delta * 0.025 * speed;
    group.rotation.x += (pointerY * 0.12 - group.rotation.x) * 0.018;
    group.rotation.z += (pointerX * 0.1 - group.rotation.z) * 0.018;
  }
  if (ringGroup) ringGroup.children.forEach((ring, i) => {
    ring.rotation.z += delta * (i % 2 ? -0.07 : 0.045) * speed;
    ring.rotation.x += delta * 0.012 * speed;
  });
  if (particles) {
    particles.rotation.y -= delta * 0.018 * speed;
    particles.rotation.x += delta * 0.008 * speed;
  }
  camera.position.x += (pointerX * 0.22 - camera.position.x) * 0.02;
  camera.position.y += (-pointerY * 0.18 - camera.position.y) * 0.02;
  camera.lookAt(0, 0, 0);
  renderer.render(scene, camera);
}

function show3DFallback() {
  canvas.style.display = 'none';
  const visual = canvas.parentElement;
  const fallback = document.createElement('div');
  fallback.className = 'scene-fallback';
  fallback.textContent = 'Your browser could not start the 3D scene. The rest of Futureverse is still available.';
  visual.appendChild(fallback);
  const style = document.createElement('style');
  style.textContent = '.scene-fallback{position:absolute;inset:20% 12%;display:grid;place-items:center;text-align:center;padding:24px;border:1px solid rgba(91,231,255,.25);background:radial-gradient(circle,rgba(91,231,255,.12),transparent 70%);color:#aab4d0;font-size:12px}';
  document.head.appendChild(style);
}

function toast(message) {
  const element = document.querySelector('#toast');
  element.textContent = message;
  element.classList.add('show');
  window.clearTimeout(toast.timer);
  toast.timer = window.setTimeout(() => element.classList.remove('show'), 2600);
}

// Mobile navigation
const menuToggle = document.querySelector('#menu-toggle');
const nav = document.querySelector('#nav');
menuToggle.addEventListener('click', () => {
  const open = menuToggle.getAttribute('aria-expanded') !== 'true';
  menuToggle.setAttribute('aria-expanded', String(open));
  menuToggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
  nav.classList.toggle('open', open);
});
nav.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
  nav.classList.remove('open');
  menuToggle.setAttribute('aria-expanded', 'false');
  menuToggle.setAttribute('aria-label', 'Open navigation');
}));

// 3D input: pointer movement only influences the scene gently.
const visual = document.querySelector('.hero-visual');
visual.addEventListener('pointermove', event => {
  const rect = visual.getBoundingClientRect();
  pointerX = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
  pointerY = ((event.clientY - rect.top) / rect.height - 0.5) * 2;
});
visual.addEventListener('pointerleave', () => { pointerX = 0; pointerY = 0; });

document.querySelector('#animation-toggle').addEventListener('click', event => {
  state.running = !state.running;
  event.currentTarget.setAttribute('aria-checked', String(state.running));
  if (state.running) { clock.getDelta(); animate(); }
  toast(state.running ? 'Orbital motion enabled.' : 'Orbital motion paused.');
});
document.querySelector('#density').addEventListener('change', event => {
  state.density = event.target.value;
  const counts = { low: prefersLowPower ? 180 : 350, medium: prefersLowPower ? 450 : 900, high: prefersLowPower ? 700 : 1600 };
  if (group && particleGeometry) createParticles(counts[state.density]);
  document.querySelector('#density-label').textContent = `${state.density[0].toUpperCase() + state.density.slice(1)} · ${counts[state.density].toLocaleString()} particles`;
  toast(`Particle density set to ${state.density}.`);
});
document.querySelector('#motion').addEventListener('input', event => {
  state.motion = Number(event.target.value) / 100;
  document.querySelector('#motion-value').textContent = `${event.target.value}%`;
});
document.querySelectorAll('.theme-swatch').forEach(button => button.addEventListener('click', () => {
  setTheme(button.dataset.theme);
  toast(`${button.dataset.theme[0].toUpperCase() + button.dataset.theme.slice(1)} energy theme applied.`);
}));

document.querySelector('#reset-scene').addEventListener('click', () => {
  state.running = !reducedMotion.matches;
  state.motion = reducedMotion.matches ? 0 : 0.6;
  state.density = 'medium';
  document.querySelector('#animation-toggle').setAttribute('aria-checked', String(state.running));
  document.querySelector('#motion').value = String(Math.round(state.motion * 100));
  document.querySelector('#motion-value').textContent = `${Math.round(state.motion * 100)}%`;
  document.querySelector('#density').value = 'medium';
  document.querySelector('#density-label').textContent = `Balanced · ${ (prefersLowPower ? 450 : 900).toLocaleString()} particles`;
  if (group) createParticles(prefersLowPower ? 450 : 900);
  setTheme('blue');
  if (state.running) animate();
  toast('Environment restored to default settings.');
});

// Concept cards provide keyboard and touch-friendly feedback.
document.querySelectorAll('.feature-action').forEach(button => {
  button.addEventListener('click', () => {
    const message = button.dataset.message;
    document.querySelector('#interaction-message').textContent = message;
    toast(message);
  });
});
document.querySelectorAll('.feature-card').forEach(card => {
  card.addEventListener('keydown', event => {
    if ((event.key === 'Enter' || event.key === ' ') && event.target === card) {
      event.preventDefault();
      card.querySelector('button')?.click();
    }
  });
});

// Local-only form validation. It deliberately does not transmit data.
const form = document.querySelector('#contact-form');
form.addEventListener('submit', event => {
  event.preventDefault();
  const fields = [...form.querySelectorAll('input, textarea')];
  let valid = true;
  fields.forEach(field => {
    const fieldValid = field.checkValidity();
    field.setAttribute('aria-invalid', String(!fieldValid));
